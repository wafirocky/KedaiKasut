# Copy to .env.docker and fill in APP_KEY (php artisan key:generate --show).
APP_NAME="Kedai Kasut"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=http://localhost:8000

# Postgres — mirrors the EasyPanel `kedaikasut-postgres` service.
# In EasyPanel set DB_HOST to the panel's Internal Host instead.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=kedaikasut
DB_USERNAME=postgres
DB_PASSWORD=secret

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
LOG_CHANNEL=stderr
